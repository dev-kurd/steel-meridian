{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "State of War",
  "version": "0.1.0",
  "identifier": "com.hostkurd.stateofwar",
  "build": {
    "frontendDist": "../game"
  },
  "app": {
    "windows": [
      {
        "title": "State of War",
        "width": 1400,
        "height": 880,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "deb",
      "rpm"
    ],
    "category": "StrategyGame",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../dist/pak/": "data/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}