# Built files: make them locally with tools/build-exe.ps1
dist/

# Local safety copies of game.js; the repository's history replaces them
backups/

# Working output of the voice tool; the lines the game plays are in sounds/voice
tools/voice-out/
tools/voice-test/

# Shortcut with a path that only works on one PC; use "Play Steel Meridian.bat"
*.lnk

# Editor and system files
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
node_modules/

# Sprite bake frames and check renders (thousands of PNG): made locally with the bake scripts in docs/*/source
bake/
bake_*/
check_refs/
__pycache__/

# Packed sprite sheets and check pictures made inside the source folders. Where the sheets live is not decided yet;
# until then they stay out of the repository.
docs/*/source/sheets*/
docs/*/source/check_pack*.jpg
docs/*/source/contact*.jpg
